{
  "name": "dsh-archive-manager",
  "version": "0.2.0",
  "description": "Archive browsing, restore, and safe permanent deletion for DeepSeek Harness Desktop and Web.",
  "type": "module",
  "main": "lib/service-plugin.js",
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "pack:local": "npm run build:client && npm pack",
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": "./lib/service-plugin.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./remote": "./lib/typert.remote-client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "archive"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.1 || ^0.1.5-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "^0.1.2-alpha.1 || ^0.1.5-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.2-alpha.1 || ^0.1.5-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-alpha.1 || ^0.1.5-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.1.2-alpha.1 || ^0.1.5-rc.1 || 0.2.0-rc.2",
    "react": "^18.2.0",
    "zod": "^4.0.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/dsh-typert-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2"
  }
}
